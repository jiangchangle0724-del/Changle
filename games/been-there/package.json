{
  "name": "been-there",
  "version": "0.4.0",
  "private": true,
  "description": "到此一游 · Been There, Bought That — an online city-property party game for changle.ca",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --var STANDALONE:1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "sim": "tsx scripts/sim.ts",
    "perf": "node scripts/perf.mjs",
    "reports": "node scripts/reports.mjs",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "fonts": "node scripts/fonts.mjs",
    "songs": "node scripts/songs.mjs",
    "world": "node scripts/gen-world.mjs",
    "satellite": "node scripts/satellite.mjs",
    "music": "node scripts/music.mjs"
  },
  "dependencies": {
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "subset-font": "^2.9.0",
    "topojson-client": "^3.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "world-atlas": "^2.0.2",
    "wrangler": "4.151.2"
  }
}
