// Cloudflare settings for 到此一游. `npm run deploy` (or a GitHub push, once Cloudflare is
// connected to the repo) builds the web pages into dist/client/trip and publishes this Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "been-there",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  // The game's files are in dist/client/trip, so they answer at /trip/…; anything that isn't a file
  // (the API, room and big-screen links, the old workers.dev address) goes to the worker.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // One of changle.ca's games: it answers at changle.ca/trip. (The rest of changle.ca is the site.)
  "routes": [
    { "pattern": "changle.ca/trip", "zone_name": "changle.ca" },
    { "pattern": "changle.ca/trip/*", "zone_name": "changle.ca" }
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "SAVES", "class_name": "SaveVault" }
    ]
  },
  // SQLite-backed Durable Objects work on Cloudflare's free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "SaveVault"] }],
  "build": { "command": "node scripts/build.mjs" },
  "observability": { "enabled": true }
}
