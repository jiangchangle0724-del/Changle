// Cloudflare settings for 到此一游. `npm run deploy` (or a GitHub push, once Cloudflare is
// connected to the repo) builds the web pages into dist/client and publishes this Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "been-there",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "SAVES", "class_name": "SaveVault" }
    ]
  },
  // SQLite-backed Durable Objects work on Cloudflare's free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "SaveVault"] }],
  "build": { "command": "node scripts/build.mjs" },
  "observability": { "enabled": true }
}
