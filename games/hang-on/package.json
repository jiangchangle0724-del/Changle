{
  "name": "@changle/hang-on",
  "version": "0.1.0",
  "private": true,
  "description": "抓紧了 · Hang On：Rapier2D 物理（A1）、房间和局域网链路（A2）、页面。契约在 CONTRACTS.md。",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types > /dev/null && tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "play": "vite --open /play.html",
    "record": "vite --open /play.html?record=1",
    "ip-check": "node scripts/ip-check.mjs",
    "levels": "node scripts/run-levels.mjs",
    "link-check": "node scripts/link-check.mjs",
    "lobby-check": "node scripts/lobby-check.mjs",
    "phone-check": "node scripts/phone-check.mjs",
    "perf": "node scripts/perf.mjs",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=src/physics/** --coverage.reportsDirectory=node_modules/.cache/hang-on-coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary --coverage.thresholds.lines=80",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.21.0",
    "pixi.js": "8.22.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.2",
    "vitest": "^5.0.5",
    "wrangler": "4.157.0"
  }
}
