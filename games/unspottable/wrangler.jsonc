// Cloudflare settings for Unspottable. The Worker serves the game and one Durable Object per room.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unspottable",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "unspottable.changle.ca", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*", "/tv/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ArenaRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaRoom"] }],
  "build": { "command": "node scripts/build.mjs" },
  "observability": { "enabled": true }
}
