{
  "name": "unspottable",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual mobile-first hidden-in-the-crowd party game for changle.ca",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --ip 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "wrangler": "4.151.2"
  }
}
