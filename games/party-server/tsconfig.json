{
  // The Worker, the shared protocol and the tests (the Workers runtime's types, from `wrangler types`).
  // The pages have their own: tsconfig.client.json (the browser's DOM types, which clash with these).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["./worker-configuration.d.ts", "node"]
  },
  "include": ["src/server", "src/shared", "tests", "scripts", "worker-configuration.d.ts"]
}
