{
  "name": "hide-crowd",
  "version": "1.0.0",
  "private": true,
  "description": "藏在人群里 · Hide in the Crowd: a bilingual phone-first party game for changle.ca",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --var STANDALONE:1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "dependencies": {
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "wrangler": "4.151.2"
  }
}
