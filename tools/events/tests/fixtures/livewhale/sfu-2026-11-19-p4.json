"date_iso":"2026-11-30T10:00:00-07:00","date_ts":1796058000,"tz_offset":-25200,"timezone":"America/Vancouver","date2_time":null,"date2_utc":null,"date2_iso":null,"date2_ts":null,"tz2_offset":null,"is_all_day":null,"repeats":"weekly","repeats_until":"December 7","repeats_start":"2026-11-09 17:00:00","repeats_end":"2026-12-07 17:00:00","is_starred":null,"is_canceled":null,"is_online":1,"online_type":"Online only","online_url":null,"online_button_label":null,"online_instructions":null,"summary":null,"cost":"Free","location":null,"location_title":null,"location_latitude":null,"location_longitude":null,"location_id":null,"event_types":["Services for Students"],"event_types_audience":["All Students"],"event_types_campus":["Online"]},{"id":50581,"gid":157,"group_title":"Molecular Biology and Biochemistry","title":"Houman Layegh Mirhosseini | MSc Thesis Defence, MBB","url":"https://events.sfu.ca/event/50581-houman-layegh-mirhosseini-msc-thesis-defence-mbb","date":"November 30","date_time":"10:00 am","date_utc":"2026-11-30 17:00:00","date_iso":"2026-11-30T10:00:00-07:00","date_ts":1796058000,"tz_offset":-25200,"timezone":"America/Vancouver","date2_time":null,"date2_utc":null,"date2_iso":null,"date2_ts":null,"tz2_offset":null,"is_all_day":null,"repeats":null,"repeats_until":null,"repeats_start":"2026-11-30 17:00:00","repeats_end":null,"is_starred":null,"is_canceled":null,"is_online":null,"online_type":null,"online_url":null,"online_button_label":null,"online_instructions":null,"summary":"<p>\n  <strong>Abstract</strong>: Diffuse large B-cell lymphoma (DLBCL) is frequently affected by aberrant somatic hypermutation (aSHM), but the regulatory effects of many resulting non-coding mutations remain unclear. This thesis developed DriveMuTR, an integrative machine learning framework that combines genomic and transcriptomic data, groups nearby simple somatic mutations into mutation foci and tests each focus for association with expression of the corresponding gene, and accounts for copy number and co-expression patterns. Candidate foci are further explored using interaction models, transcription factor motif predictions controlled for local mutational bias, and allelic imbalance analysis. DriveMuTR was applied to 88 genes, and 74 contained at least one significant mutation focus. DriveMuTR identified significant mutation foci associated with altered gene expression and predicted effects of mutations within these foci on transcription factor binding. Collectively, this work prioritizes candidate regulatory mutations for further functional validation in DLBCL.\n</p>","cost":"Free","location":"LIB 2020, Thesis Defence Room, Bennett Library","location_title":null,"location_latitude":null,"location_longitude":null,"location_id":null,"event_types":["Thesis Defences"],"event_types_audience":["Graduate Students","Public"],"event_types_campus":["SFU Burnaby Campus"]},{"id":50939,"gid":65,"group_title":"Faculty of Education","title":"PhD Thesis Defence - Sharon Johnsey (On-campus)","url":"https://events.sfu.ca/event/50939-phd-thesis-defence-sharon-johnsey-on-campus","date":"November 30","date_time":"10:00 am","date_utc":"2026-11-30 17:00:00","date_iso":"2026-11-30T10:00:00-07:00","date_ts":1796058000,"tz_offset":-25200,"timezone":"America/Vancouver","date2_time":null,"date2_utc":null,"date2_iso":null,"date2_ts":null,"tz2_offset":null,"is_all_day":null,"repeats":null,"repeats_until":null,"repeats_start":"2026-11-30 17:00:00","repeats_end":null,"is_starred":null,"is_canceled":null,"is_online":null,"online_type":null,"online_url":null,"online_button_label":null,"online_instructions":null,"summary":"<p>\n  You are invited to attend Sharon Johnsey’s thesis examination.\n</p>","cost":"Free","location":"SFU Burnaby, Room EDB 7610","location_title":null,"location_latitude":null,"location_longitude":null,"location_id":null,"event_types":["Thesis Defences"],"event_types_audience":["All Students","Alumni","Faculty","Staff"],"event_types_campus":["SFU Burnaby Campus