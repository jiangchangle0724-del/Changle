{
  "name": "changle-events",
  "version": "0.1.0",
  "private": true,
  "description": "玩什么 · What's On: Greater Vancouver's events for the next 14 days, gathered every morning, for changle.ca/go",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --var ALLOW_TEST:1",
    "types": "wrangler types",
    "typecheck": "wrangler types > /dev/null && tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "eval": "tsx scripts/eval.ts",
    "libraries": "tsx scripts/libraries.ts"
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "22.20.5",
    "typescript": "6.0.2",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
