{
  "name": "when",
  "version": "0.1.0",
  "private": true,
  "description": "约时间 · When Works: when can everyone make it? A scheduling tool for changle.ca",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
