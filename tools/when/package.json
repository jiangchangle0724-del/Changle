  "dependencies": {
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "wrangler": "4.151.2"
  }
}
